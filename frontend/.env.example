# ==============================================================================
# CARB-PLANNER — PRODUCTION ENVIRONMENT VARIABLES (FRONTEND / VERCEL)
# ==============================================================================
# In Vercel, set these in Project Settings -> Environment Variables.

# Render FastAPI Backend Base URL (without trailing slash)
# Production: https://carb-planner-backend.onrender.com
# Development: Leave empty to use local Vite proxy or set to http://localhost:8000
VITE_API_BASE_URL=https://carb-planner-backend.onrender.com

# Optional Google Maps Browser API Key (Restricted to your Vercel domains)
VITE_GOOGLE_MAPS_API_KEY=
