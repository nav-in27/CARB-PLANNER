# ==============================================================================
# CARB-PLANNER — PRODUCTION ENVIRONMENT VARIABLES (BACKEND / RENDER / SUPABASE)
# ==============================================================================
# Copy this file to .env for local development. Never commit real credentials to git!

# Server & Environment
PORT=8000
ENVIRONMENT=production

# Supabase PostgreSQL Database (Transaction Pooler or Direct Connection)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Supabase API (Optional - for Supabase Auth / Storage)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Production CORS Configuration (Comma-separated list of allowed origins)
# Example: https://carb-planner.vercel.app,http://localhost:5173
CORS_ORIGINS=https://carb-planner.vercel.app,http://localhost:5173,http://localhost:3000

# Security & Optimization
SECRET_KEY=carb-planner-secret-change-in-production-random-64-chars
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# Optional Google Maps API Key for Backend GIS
GOOGLE_MAPS_API_KEY=
